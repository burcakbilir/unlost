# Postgres with pgvector. Locally: docker compose up -d. In production: your Neon connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/unlost?schema=public

# Signs session cookies. At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=replace-with-a-long-random-secret

# Encrypts users' Gemini API keys at rest. Exactly 32 random bytes, base64: openssl rand -base64 32
# Never change it after users have saved keys, or their keys can no longer be read.
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Only used by scripts/create-invites.ts to print full invite links.
APP_URL=http://localhost:3000
