generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // The user's own Gemini API key, AES-256-GCM encrypted (see src/lib/secret-box.ts).
  // Null until they add one; AI features stay off without it.
  geminiApiKeyEncrypted String?

  libraryItems LibraryItem[]
  inviteCode   InviteCode?

  @@map("users")
}

// Sign-up is invite-only: each code can be redeemed by exactly one account.
model InviteCode {
  code      String    @id
  usedById  String?   @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  usedBy User? @relation(fields: [usedById], references: [id], onDelete: SetNull)

  @@map("invite_codes")
}

// Fixed-window counters. Kept in Postgres rather than memory so limits hold
// across serverless instances and restarts.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@map("rate_limits")
}

model LibraryItem {
  id          String   @id @default(cuid())
  ownerId     String
  type        String
  title       String
  description String   @default("")
  source      String   @default("")
  tags        String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  imageData     Bytes?
  imageMimeType String?
  imageCaption  String?

  embedding Unsupported("vector(768)")?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt])
  @@map("library_items")
}
